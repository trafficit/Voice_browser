# Скопируйте в .env и подставьте значения ПОД ХОСТ Ubuntu (команды справа надо
# выполнить в терминале Ubuntu-машины, ДО docker compose up)

# echo $DISPLAY   (обычно :0 или :1)
DISPLAY=:0

# echo $XDG_RUNTIME_DIR   (обычно /run/user/1000, где 1000 - id вашего юзера, см. `id -u`)
XDG_RUNTIME_DIR=/run/user/1000

# Слово-переключатель (можно несколько через запятую - сработает любое):
# сказала - ассистент активируется и слушает команды свободно.
START_WORD=запустись,запусти,запускай,включись

# Слово-переключатель (можно несколько через запятую): сказала - ассистент
# перестаёт выполнять команды до START_WORD.
STOP_WORD=остановись,выключись,хватит

# Если в активном режиме N секунд подряд полная тишина - авто-возврат в режим
# ожидания START_WORD (на случай, если забыли сказать STOP_WORD).
AUTO_STOP_AFTER_S=600

# Модель Faster-Whisper: tiny / base / small / medium
# small - хороший баланс качества/скорости для обычного ПК без GPU.
# Если ПК слабый и распознавание "тормозит" - поставьте tiny или base.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Частота записи с микрофона (Гц). 48000 подходит почти всем USB-микрофонам.
# Если видите в логах "Invalid sample rate" - попробуйте 44100.
AUDIO_SAMPLE_RATE=48000

# Подстрока для выбора микрофона, если в системе их несколько (например
# встроенный + USB). По умолчанию ищем "usb". Если ассистент слушает не тот
# микрофон - посмотрите точные имена устройств в логах контейнера
# (docker compose logs) и впишите сюда часть названия вашего микрофона,
# например "Nor-Tec".
AUDIO_DEVICE_MATCH=usb

# Частота воспроизведения гудков/озвучки (Гц). 48000 подходит почти всем
# звуковым картам. Если совсем нет звука из динамиков - попробуйте 44100.
AUDIO_OUTPUT_SAMPLE_RATE=48000

# Подстрока для выбора устройства ВЫВОДА звука (колонки), если их несколько
# (например встроенные колонки + HDMI + монитор USB-микрофона). Пусто -
# системное умолчание. Если звук не слышно - посмотрите список устройств в
# логах контейнера (строки "Аудиоустройство [N]: ... выход=") и впишите сюда
# часть названия ваших колонок, например "PCH" или "Analog".
AUDIO_OUTPUT_MATCH=
